APP_NAME=Student Success Predictor API
ENVIRONMENT=development

# Phase 7 will use PostgreSQL.
# Example:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/student_success_predictor
DATABASE_URL=

# Phase 6 will load the trained model from this path.
MODEL_PATH=app/ml/student_success_model.pkl

# LLM Recommendation Engine Settings
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash